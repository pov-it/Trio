        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC brukes til å skanne Libre-sensorer."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC sa používa na skenovanie snímačov Libre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC 用于扫描 Libre 传感器。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Privacy - Bluetooth Always Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth се използва за комуникация с инсулинова помпа и CGM устройства"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "new",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth bliver brugt til at kommunikere med din insulin pumpe og dine glukose monitor enheder"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth wird verwendet, um mit Insulinpumpen und CGMs zu kommunizieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth est utilisé pour communiquer avec la pompe à insuline et les dispositifs de surveillance continue du glucose"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il bluetooth viene utilizzato per comunicare con il microinfusore e i dispositivi CGM"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth brukes til å kommunisere med insulinpumpe og CGM"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth wordt gebruikt om met je insulinepomp en continue glucosemonitor (CGM) te communiceren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "new",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth используется для связи с инсулиновой помпой и устройствами непрерывного мониторинга глюкозы"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth används för att kommunicera med pump och kontinuerlig glukosmätare"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth, insülin pompası ve sürekli glikoz izleme cihazları ile iletişim kurmak için kullanılır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth використовується для обміну з інсуліновими помпами та безперервним моніторингом глюкози"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth được sử dụng để liên lạc với máy bơm insulin và các thiết bị theo dõi đường huyết liên tục/CGM."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "藍牙用於與胰島素幫浦及連續血糖監測裝置通訊"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth brukes til å kommunisere med insulinpumpe og blodsukkersensor"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth is used to communicate with insulin pump and continuous glucose monitor devices"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bluetooth sa používa pre komunikáciu s inzulínovou pumpou a zariadeniami na kontinuálne monitorovanie krvného cukru"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙用于与胰岛素泵和连续血糖监测设备进行通信"
          }
        }
      }
    },
