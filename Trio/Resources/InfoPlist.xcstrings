    "NSContactsUsageDescription": {
      "comment": "Privacy - Contacts Usage Description",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволява на Trio достъп до контактите Ви за актуализации на контакта на циферблата на Apple Watch чрез функцията „Contact Trick“."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "new",
            "value": "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
          }
        },
        "da": {
          "stringUnit": {
            "state": "new",
            "value": "Allows Trio to access your contacts for live updates to your Apple Watch contact complication using the 'Contact Trick' feature."
