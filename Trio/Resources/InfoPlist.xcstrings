    "NFCReaderUsageDescription": {
      "comment": "Privacy - NFC Scan Usage Description",
      "extractionState": "extracted_with_value",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC се използва за сканиране на Libre сензори."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "new",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC bruges til at scanne Libre sensorer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC wird zum Scannen von Libre Sensoren benutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC est utilisé pour scanner les capteurs Libre."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC è usato per scansionare i sensori di Libre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "new",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "nb-NO": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC wordt gebruikt om Libre-sensoren te scannen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "new",
            "value": "NFC is used to scan Libre sensors."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC используется для сканирования сенсоров Libre."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC används för att skanna Libre-sensorn vid uppstart."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC Libre sensörlerini taramak için kullanılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC використовується для сканування сенсорів Libre."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC được sử dụng để quét các cảm biến Libre."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "NFC 用於掃描 Libre 傳感器。"
          }
        },
